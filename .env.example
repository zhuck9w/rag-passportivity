# Имена переменных для .env (значения не коммитим).
NOTION_TOKEN=
NOTION_KB_PAGE_ID=
VOYAGE_API_KEY=
# Языковая модель: deepseek (по умолчанию) или anthropic (откат + рестарт).
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Нужен только при LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Альтернативное имя того же ключа: если в .env он называется SUPABASE_SECRET,
# config.py подхватит и его (SUPABASE_SECRET_KEY имеет приоритет).
SUPABASE_SECRET=
SLACKBOT_OAUTH=
SLACKBOT_APPLEVEL=
# Прокси для всего исходящего трафика (формат http://логин:пароль@адрес:порт).
# Работает только при PROXY_ENABLED=true; иначе соединение прямое.
PROXY=
PROXY_ENABLED=false
# Модели. Пусто = дефолт провайдера из config.py (DeepSeek: ответы
# deepseek-flash, переформулировщик deepseek-v4-pro; Claude: Haiku 4.5 и
# Sonnet 5). Имена claude-... при LLM_PROVIDER=deepseek игнорируются.
ANSWER_MODEL=
REWRITE_MODEL=
# Писать ли текст вопросов в лог бота (journalctl). По умолчанию нет —
# включать временно, для разбора конкретного случая (+ рестарт бота).
LOG_QUESTIONS=false
